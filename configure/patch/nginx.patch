+++ src-2/nginx-1.24.0/auto/unix	2026-10-13 06:40:47.076614679 +0000
@@ -780,6 +780,12 @@ if [ $ngx_found = no ]; then
     . auto/feature
 fi
 
+if [ $ngx_found = no ]; then
