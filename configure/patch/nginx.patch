diff -urNp src/nginx-1.14.2/auto/feature src-2/nginx-1.24.0/auto/feature
--- src/nginx-1.14.2/auto/feature	2018-12-04 14:52:24.000000000 +0000
+++ src-2/nginx-1.24.0/auto/feature	2026-10-13 06:29:30.793805289 +0000
@@ -64,6 +64,16 @@ if [ -x $NGX_AUTOTEST ]; then
             else
                 echo " found but is not working"
             fi
+
+            # cross-compilation: if the binary was built but can't run,
+            # treat it as found anyway
+            if [ $ngx_found = no ]; then
+                echo " (assuming found for cross-compilation)"
+                ngx_found=yes
+                if test -n "$ngx_feature_name"; then
+                    have=$ngx_have_feature . auto/have
+                fi
+            fi
         ;;
 
         value)
@@ -82,6 +92,12 @@ END
             else
                 echo " found but is not working"
             fi
+
+            # cross-compilation: if the binary was built but can't run,
+            # skip the value check (can't get the value)
+            if [ $ngx_found = no ]; then
+                echo " (assuming not supported for cross-compilation)"
+            fi
         ;;
 
         bug)
@@ -97,6 +113,12 @@ END
                     have=$ngx_have_feature . auto/have
                 fi
             fi
+
+            # cross-compilation: if the binary was built but can't run,
+            # conservatively assume the bug is not present
+            if [ $ngx_found = no ]; then
+                echo " (assuming not found for cross-compilation)"
+            fi
         ;;
 
         *)
@@ -120,4 +142,4 @@ else
     echo "----------"    >> $NGX_AUTOCONF_ERR
 fi
 
-rm -rf $NGX_AUTOTEST*
+rm -rf $NGX_AUTOTEST*
\ No newline at end of file
diff -urNp src/nginx-1.14.2/auto/types/sizeof src-2/nginx-1.24.0/auto/types/sizeof
--- src/nginx-1.14.2/auto/types/sizeof	2018-12-04 14:52:24.000000000 +0000
+++ src-2/nginx-1.24.0/auto/types/sizeof	2026-10-13 06:37:37.841404086 +0000
@@ -1,4 +1,3 @@
-
 # Copyright (C) Igor Sysoev
 # Copyright (C) Nginx, Inc.
 
@@ -40,7 +39,46 @@ eval "$ngx_test >> $NGX_AUTOCONF_ERR 2>&
 
 
 if [ -x $NGX_AUTOTEST ]; then
-    ngx_size=`$NGX_AUTOTEST`
+    ngx_size=`$NGX_AUTOTEST 2>/dev/null`
+
+    if [ -z "$ngx_size" ]; then
+        echo $ngx_n " (cross-compiling, using compile-time detection)$ngx_c"
+
+        case "$ngx_type" in
+            "void *") ngx_type_normalized="POINTER" ;;
+            *)        ngx_type_normalized=`echo "$ngx_type" | tr ' *' '_P'` ;;
+        esac
+        ngx_size=`echo "__SIZEOF_${ngx_type_normalized}__" \
+                  | $CC -E -P -x c - 2>/dev/null | tail -1 | tr -d ' '`
+
+        if [ -z "$ngx_size" ] \
+           || [ "$ngx_size" = "__SIZEOF_${ngx_type_normalized}__" ]
+        then
+            ngx_size=
+            for ngx_try in 1 2 4 8 16; do
+                cat > $NGX_AUTOTEST.c << END
+#include <sys/types.h>
+#include <sys/time.h>
+$NGX_INCLUDE_UNISTD_H
+#include <signal.h>
+#include <stdlib.h>
+#include <stdio.h>
+#include <sys/resource.h>
+$NGX_INCLUDE_INTTYPES_H
+$NGX_INCLUDE_AUTO_CONFIG_H
+int main(void) {
+    char a[($ngx_try == sizeof($ngx_type)) ? 1 : -1];
+    return 0;
+}
+END
+                if $CC $CC_TEST_FLAGS -c -o /dev/null $NGX_AUTOTEST.c 2>/dev/null; then
+                    ngx_size=$ngx_try
+                    break
+                fi
+            done
+        fi
+    fi
+
     echo " $ngx_size bytes"
 fi
 
@@ -72,5 +110,4 @@ case $ngx_size in
 esac
 
 
-rm -rf $NGX_AUTOTEST*
-
+rm -rf $NGX_AUTOTEST*
\ No newline at end of file
